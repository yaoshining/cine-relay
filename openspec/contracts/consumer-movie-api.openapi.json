{
  "openapi": "3.1.0",
  "info": {
    "title": "CineRelay API",
    "version": "1.0.0",
    "description": "从服务端调用；不要将应用密钥嵌入网站或客户端。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "AppKey": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/api/v1/movies/{tmdbId}": {
      "get": {
        "operationId": "getMovie",
        "summary": "获取单部电影详情",
        "description": "按语言精确查找缓存。cache=stale 表示返回了仍在保留期内的过期值。",
        "security": [
          {
            "AppKey": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "tmdbId",
            "required": true,
            "description": "正整数 ID，按十进制字符串传输。",
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          },
          {
            "in": "query",
            "name": "lang",
            "schema": {
              "type": "string",
              "enum": [
                "zh-CN",
                "en-US"
              ],
              "default": "zh-CN"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "详情与缓存状态。",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "tmdbId": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{0,18}$"
                    },
                    "locale": {
                      "type": "string",
                      "enum": [
                        "zh-CN",
                        "en-US"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "originalTitle": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "overview": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "posterPath": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "releaseDate": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "date",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "genreIds": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    },
                    "originalLanguage": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "runtimeMinutes": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "fetchedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "cache": {
                      "type": "string",
                      "enum": [
                        "hit",
                        "refreshed",
                        "stale"
                      ]
                    },
                    "stale": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "tmdbId",
                    "locale",
                    "title",
                    "originalTitle",
                    "overview",
                    "posterPath",
                    "releaseDate",
                    "genreIds",
                    "originalLanguage",
                    "runtimeMinutes",
                    "fetchedAt",
                    "expiresAt",
                    "cache",
                    "stale"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "ID 或语言参数无效。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "const": "invalid_request"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "缺少有效服务端凭据。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "const": "unauthorized"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "headers": {
              "WWW-Authenticate": {
                "schema": {
                  "type": "string",
                  "const": "Bearer"
                }
              }
            }
          },
          "404": {
            "description": "电影不存在或已下架。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "const": "not_found"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "暂不可用，按 Retry-After 重试。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "const": "unavailable"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "建议等待秒数。",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
