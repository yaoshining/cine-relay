{
  "openapi": "3.1.0",
  "info": {
    "title": "CineRelay 剧集接口（联调契约）",
    "version": "0.1.0",
    "description": "本地合成数据服务；不表示 staging 或生产可用。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4317"
    }
  ],
  "security": [
    {
      "AppKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "AppKey": {
        "type": "http",
        "scheme": "bearer"
      }
    }
