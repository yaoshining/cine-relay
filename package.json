{
  "name": "cine-relay",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "import:tmdb": "node scripts/tmdb_import.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:db": "tsx --test tests/db.test.ts tests/movie-catalog.test.ts tests/sync-runs.test.ts tests/consumer-api.test.ts tests/schedules.test.ts tests/test_tmdb_import.mjs",
    "test:auth:http": "node --test tests/admin-auth.http.mjs",
    "test": "npm run test:db && tsx --test tests/admin-auth.test.ts tests/tmdb-sample.test.ts tests/*.test.tsx && python3 -m unittest discover -s tests"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "@scalar/api-reference-react": "0.9.97",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "inngest": "4.27.0",
    "lucide-react": "1.80.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "inngest": {
      "zod": "$zod"
    },
    "gaxios": {
      "rimraf": "6.1.4"
    },
    "@opentelemetry/api": "1.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  }
}
